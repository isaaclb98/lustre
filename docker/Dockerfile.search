# Single-container image for lustre.
#
# Builds the SvelteKit frontend as a static SPA and packages it with
# the FastAPI backend into one image. The FastAPI app serves both the
# JSON API (existing /api/* routes) and the SPA static files (mounts
# /_app/ for hashed assets, falls back to index.html for any other
# path). One container, one port (8000), one Service — eliminates the
# per-route Caddy config that required cluster DNS lookups.

# syntax=docker/dockerfile:1.4 — required for --mount cache mounts
# that keep pip + apt caches warm between builds (round‑13: cut dev
# rebuild from ~4 min to ~30s on source-only edits).
# syntax=docker/dockerfile:1.4
ARG NODE_VERSION=20.19.0
ARG PYTHON_VERSION=3.11

#--------------------------------------------------------------------
# Stage 1 — build the SvelteKit SPA (adapter-static)
#--------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS frontend-build
WORKDIR /web

# Install deps first for layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

# Build. adapter-static output lands in /web/build
COPY frontend/ ./
RUN --mount=type=cache,target=/root/.npm \
    npm run build

#--------------------------------------------------------------------
# Stage 2 — Python backend with the SPA bundled in
#--------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS backend

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build toolchain + curl for the HEALTHCHECK + libvips for
# thumbnail generation. pyvips (the Python binding) is a pip
# dep; the underlying C library has to be installed at the
# system level. libvips42 + libvips-tools is enough — libvips
# pulls in libjpeg/libpng/libwebp as needed. If libvips is
# ever unavailable in the base image the indexer falls back
# to a slower PIL+numpy path (see indexer/thumbnails.py).
# apt cache is mounted from the host so `apt-get update` and the
# download list survive across builds.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libvips42 \
        libvips-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ─── Round‑13: split dependency install from source install ──────────────────
# `pip install .` re‑runs `pip install` for any change to the source
# tree and re‑downloads the multi‑hundred‑MB torch + CUDA + timm
# wheels even though only a couple of .py files moved. To make dev
# rebuilds fast we do it in two phases:
#
#   1. Install only the *dependencies* listed in pyproject.toml.
#      This layer is invalidated only when pyproject.toml changes.
#      Wheels are kept warm by the `--mount=type=cache` from above.
#   2. Copy the source code and install our own package with
#      `--no-deps` so pip only copies .py files into site-packages
#      (a few seconds, no network).
#
# Result: source‑only edits rebuild in seconds instead of minutes.

# 1. deps layer — pyproject.toml only
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -c "import tomllib, sys; \
              t = tomllib.load(open('pyproject.toml', 'rb')); \
              print('\n'.join(t['project']['dependencies']))" \
              > /tmp/requirements.txt \
 && pip install --upgrade pip \
 && pip install -r /tmp/requirements.txt

# 2. source layer — copy packages, then install ours (no deps)
COPY lustre_kernel/ ./lustre_kernel/
COPY search/ ./search/
COPY indexer/ ./indexer/
COPY scripts/ ./scripts/
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-deps .

# Source code that isn't part of the installed package
COPY scripts/ ./scripts/
# NOTE: no `COPY data/` — that path is local state (the SQLite
# index cache) and is .gitignore'd. The cluster mounts a PVC at
# /app/data at runtime, and INDEX_DB_PATH pins the file to
# /app/data/images.db. See the GitHub repo's deploy recipes
# (docker-compose.yml + oracle-compose.yml) for the bind-mount
# shape; no k8s StatefulSet for lustre.

# Bundle the prebuilt SPA at /app/static. The backend's create_app()
# mounts /_app/ for hashed assets and falls back to index.html for
# everything else.
COPY --from=frontend-build /web/build /app/static

# The SigLIP2 weights are NOT baked into the image. They live in
# /app/data/hf-cache (the lustre_search_data named volume)
# and are downloaded on first use. The HF cache persists across
# container restarts, so the one-time ~370MB-1.8GB download happens
# once per deployment, not once per restart. Bumping the Dockerfile
# to a new variant wipes the cache only if the volume is dropped.

ENV WEB_CONCURRENCY=1 \
    PORT=8000 \
    # HF model cache lives on the PVC at /app/data/hf-cache so it
    # survives container restarts AND avoids filling the small root
    # volume (~14 GB free). Both transformers and open_clip respect
    # HF_HOME as the canonical cache root.
    HF_HOME=/app/data/hf-cache \
    HF_HUB_CACHE=/app/data/hf-cache/hub \
    TRANSFORMERS_CACHE=/app/data/hf-cache/hub

EXPOSE 8000

# Healthcheck against the backend's own /healthz
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1

CMD ["sh", "-c", "exec gunicorn search.app:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY} --timeout 120 --graceful-timeout 90 --access-logfile -"]
